<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  width: 100%;
  height: 100%;
  background: #fff;
  overflow: hidden;
}

body {
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  color: #1a1a1a;
  -webkit-font-smoothing: antialiased;
}

.page {
  width: 1872px;
  height: 1404px;
  padding: 56px 72px;
  position: relative;
  transform-origin: top left;
}

/* ---- DATE HEADER ---- */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 28px;
}
.date-header .day-label {
  font-size: 34px;
  font-weight: 700;
  color: #777;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 2px;
}
.date-header .full-date {
  font-size: 50px;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: -0.5px;
}
.update-time {
  font-size: 24px;
  color: #aaa;
  padding-bottom: 6px;
}

/* ---- DIVIDERS ---- */
.divider {
  width: 100%;
  height: 3px;
  background: #ccc;
  margin-bottom: 28px;
}

/* ---- MAIN CONTENT (two columns) ---- */
.main-content {
  display: flex;
  gap: 56px;
}

/* ---- LEFT: WEATHER ---- */
.weather-col {
  flex: 1;
}
.weather-top {
  display: flex;
  align-items: flex-start;
  gap: 32px;
  margin-bottom: 12px;
}
.weather-main { flex: 1; }
.weather-temp {
  font-size: 180px;
  font-weight: 600;
  line-height: 0.88;
  letter-spacing: -7px;
  color: #1a1a1a;
}
.weather-temp span {
  font-size: 90px;
  vertical-align: top;
  letter-spacing: 0;
  font-weight: 400;
}
.weather-condition {
  font-size: 32px;
  color: #555;
  margin-top: 10px;
}
.weather-feels {
  font-size: 26px;
  color: #999;
  margin-top: 2px;
}
.weather-icon-area {
  width: 150px;
  height: 150px;
  background: #edece6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 8px;
}
.weather-icon-area svg { width: 84px; height: 84px; }

/* ---- HOURLY STRIP ---- */
.hourly-strip {
  display: flex;
  border: 2px solid #ddd;
  border-radius: 12px;
  overflow: hidden;
  margin: 16px 0 0;
}
.hourly-item {
  flex: 1;
  text-align: center;
  padding: 14px 6px;
  border-right: 1px solid #eee;
}
.hourly-item:last-child { border-right: none; }
.hourly-item .hour {
  font-size: 22px;
  color: #999;
  margin-bottom: 2px;
}
.hourly-item .htemp {
  font-size: 34px;
  font-weight: 600;
  color: #1a1a1a;
}
.hourly-item.now { background: #edece6; }

/* ---- VERTICAL DIVIDER ---- */
.v-divider {
  width: 3px;
  background: #ccc;
  align-self: stretch;
  flex-shrink: 0;
}

/* ---- RIGHT: CALENDAR ---- */
.calendar-col {
  flex: 1;
}
.section-label {
  font-size: 26px;
  font-weight: 700;
  color: #999;
  letter-spacing: 3px;
  text-transform: uppercase;
  margin-bottom: 16px;
}
</style>
</head>
<body>
<div class="page">

  <!-- HEADER ROW -->
  <div class="header-row">
    <div class="date-header">
      <div class="day-label" id="dayLabel">Loading...</div>
      <div class="full-date" id="fullDate"></div>
    </div>
    <div class="update-time" id="updateTime"></div>
  </div>

  <div class="divider"></div>

  <!-- TWO-COLUMN LAYOUT -->
  <div class="main-content">

    <!-- LEFT: WEATHER -->
    <div class="weather-col">
      <div class="weather-top">
        <div class="weather-main">
          <div class="weather-temp" id="mainTemp">--<span>°</span></div>
          <div class="weather-condition" id="weatherCondition">Loading weather...</div>
          <div class="weather-feels" id="feelsLike"></div>
        </div>
        <div class="weather-icon-area">
          <svg id="weatherIcon" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="22" fill="#ccc" stroke="#999" stroke-width="3"/>
          </svg>
        </div>
      </div>

      <div class="hourly-strip" id="hourlyStrip">
        <div class="hourly-item"><div class="hour">--</div><div class="htemp">--°</div></div>
        <div class="hourly-item"><div class="hour">--</div><div class="htemp">--°</div></div>
        <div class="hourly-item"><div class="hour">--</div><div class="htemp">--°</div></div>
        <div class="hourly-item"><div class="hour">--</div><div class="htemp">--°</div></div>
        <div class="hourly-item"><div class="hour">--</div><div class="htemp">--°</div></div>
        <div class="hourly-item"><div class="hour">--</div><div class="htemp">--°</div></div>
      </div>
    </div>

    <!-- VERTICAL DIVIDER -->
    <div class="v-divider"></div>

    <!-- RIGHT: CALENDAR HEADER ONLY -->
    <div class="calendar-col">
      <div class="section-label">Today's schedule</div>
      <!-- Calendar widget, divider line, and sensor tiles placed manually on device below this point -->
    </div>

  </div>

</div>

<script>
// --- DATE ---
const now = new Date();
const days = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
document.getElementById("dayLabel").textContent = days[now.getDay()];
document.getElementById("fullDate").textContent = months[now.getMonth()] + " " + now.getDate() + ", " + now.getFullYear();
const hh = String(now.getHours()).padStart(2,"0");
const mm = String(now.getMinutes()).padStart(2,"0");
document.getElementById("updateTime").textContent = "Updated " + hh + ":" + mm;

// --- WEATHER via Open-Meteo (free, no API key) ---
const LAT = 59.72;
const LON = 10.84;

const WMO_CODES = {
  0: "Clear sky", 1: "Mainly clear", 2: "Partly cloudy", 3: "Overcast",
  45: "Fog", 48: "Freezing fog",
  51: "Light drizzle", 53: "Drizzle", 55: "Heavy drizzle",
  61: "Light rain", 63: "Rain", 65: "Heavy rain",
  66: "Freezing rain", 67: "Heavy freezing rain",
  71: "Light snow", 73: "Snow", 75: "Heavy snow", 77: "Snow grains",
  80: "Light showers", 81: "Showers", 82: "Heavy showers",
  85: "Light snow showers", 86: "Heavy snow showers",
  95: "Thunderstorm", 96: "Thunderstorm with hail", 99: "Thunderstorm with heavy hail"
};

function updateWeatherIcon(code) {
  const svg = document.getElementById("weatherIcon");
  if (code >= 61 || code === 51 || code === 53 || code === 55) {
    svg.innerHTML = '<path d="M25,40 Q25,20 50,20 Q55,8 70,15 Q88,15 85,35 Q95,38 90,50 Q90,58 80,58 L25,58 Q12,58 15,45 Q15,40 25,40Z" fill="#bbb" stroke="#888" stroke-width="2"/><line x1="35" y1="65" x2="30" y2="80" stroke="#888" stroke-width="3" stroke-linecap="round"/><line x1="55" y1="65" x2="50" y2="80" stroke="#888" stroke-width="3" stroke-linecap="round"/><line x1="72" y1="65" x2="67" y2="80" stroke="#888" stroke-width="3" stroke-linecap="round"/>';
  } else if ((code >= 71 && code <= 77) || (code >= 85 && code <= 86)) {
    svg.innerHTML = '<path d="M25,40 Q25,20 50,20 Q55,8 70,15 Q88,15 85,35 Q95,38 90,50 Q90,58 80,58 L25,58 Q12,58 15,45 Q15,40 25,40Z" fill="#bbb" stroke="#888" stroke-width="2"/><circle cx="32" cy="72" r="4" fill="#999"/><circle cx="52" cy="68" r="4" fill="#999"/><circle cx="72" cy="74" r="4" fill="#999"/><circle cx="42" cy="82" r="4" fill="#999"/><circle cx="62" cy="84" r="4" fill="#999"/>';
  } else if ((code >= 2 && code <= 3) || (code >= 45 && code <= 48)) {
    svg.innerHTML = '<path d="M20,55 Q20,35 45,35 Q50,20 65,28 Q82,25 80,45 Q92,48 87,60 Q87,68 75,68 L20,68 Q8,68 10,55 Q10,50 20,55Z" fill="#bbb" stroke="#888" stroke-width="2"/>';
  } else if (code === 1) {
    svg.innerHTML = '<circle cx="38" cy="40" r="20" fill="#ccc" stroke="#999" stroke-width="3"/><line x1="38" y1="12" x2="38" y2="5" stroke="#999" stroke-width="3"/><line x1="38" y1="68" x2="38" y2="75" stroke="#999" stroke-width="3"/><line x1="10" y1="40" x2="3" y2="40" stroke="#999" stroke-width="3"/><line x1="66" y1="40" x2="73" y2="40" stroke="#999" stroke-width="3"/><path d="M55,60 Q55,50 65,50 Q68,44 75,47 Q82,47 80,55 Q85,56 83,62 Q83,65 78,65 L55,65 Q50,65 52,60 Q52,58 55,60Z" fill="#ddd" stroke="#aaa" stroke-width="1.5"/>';
  } else {
    svg.innerHTML = '<circle cx="50" cy="50" r="22" fill="#ccc" stroke="#999" stroke-width="3"/><line x1="50" y1="18" x2="50" y2="8" stroke="#999" stroke-width="3"/><line x1="50" y1="82" x2="50" y2="92" stroke="#999" stroke-width="3"/><line x1="18" y1="50" x2="8" y2="50" stroke="#999" stroke-width="3"/><line x1="82" y1="50" x2="92" y2="50" stroke="#999" stroke-width="3"/><line x1="27" y1="27" x2="20" y2="20" stroke="#999" stroke-width="3"/><line x1="73" y1="73" x2="80" y2="80" stroke="#999" stroke-width="3"/><line x1="27" y1="73" x2="20" y2="80" stroke="#999" stroke-width="3"/><line x1="73" y1="27" x2="80" y2="20" stroke="#999" stroke-width="3"/>';
  }
}

fetch(`https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,apparent_temperature,weather_code&hourly=temperature_2m&timezone=Europe%2FOslo&forecast_days=1`)
  .then(r => r.json())
  .then(data => {
    const curr = data.current;
    const temp = Math.round(curr.temperature_2m);
    const feels = Math.round(curr.apparent_temperature);
    const code = curr.weather_code;

    document.getElementById("mainTemp").innerHTML = temp + '<span>°</span>';
    document.getElementById("weatherCondition").textContent = WMO_CODES[code] || "Unknown";
    document.getElementById("feelsLike").textContent = "Feels like " + feels + "°";
    updateWeatherIcon(code);

    const currentHour = now.getHours();
    const hourlyTemps = data.hourly.temperature_2m;
    const hourlyTimes = data.hourly.time;

    let html = "";
    for (let i = 0; i < 6; i++) {
      const idx = currentHour + i;
      if (idx < hourlyTemps.length) {
        const h = new Date(hourlyTimes[idx]).getHours();
        const label = String(h).padStart(2, "0") + ":00";
        const t = Math.round(hourlyTemps[idx]);
        const cls = i === 0 ? ' now' : '';
        html += '<div class="hourly-item' + cls + '"><div class="hour">' + label + '</div><div class="htemp">' + t + '°</div></div>';
      }
    }
    document.getElementById("hourlyStrip").innerHTML = html;
  })
  .catch(() => {
    document.getElementById("weatherCondition").textContent = "Weather unavailable";
  });

// --- AUTO-SCALE to fit any viewport ---
function scalePage() {
  const page = document.querySelector('.page');
  const scaleX = window.innerWidth / 1872;
  const scaleY = window.innerHeight / 1404;
  const scale = Math.min(scaleX, scaleY);
  page.style.transform = 'scale(' + scale + ')';
}
scalePage();
window.addEventListener('resize', scalePage);
</script>
</body>
</html>
